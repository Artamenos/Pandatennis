{
  "name": "pandatennis",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run typecheck && npm run lint && npm run build",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "test:export": "node --test tests/export.test.mjs",
    "preflight": "npm run check && npm run check:placeholders && npm run test:export"
  },
  "dependencies": {
    "lucide-react": "1.44.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  }
}
